/**
 * Cloudflare Workers configuration for FOSSTrak India.
 * Copy this file to wrangler.jsonc and use the ID of your own KV namespace.
 * Never commit account-specific IDs or secrets to a reusable example config.
 * See https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fosstrak-india",
  "main": "src/index.js",
  "compatibility_date": "2026-10-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "EVENTS",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
